# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file (it's in .gitignore).

# Secret used to sign login tokens. Generate a random one for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me

# Database. Defaults to a local SQLite file for development.
# For production (Postgres) it looks like:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./pickly.db

# How long a login stays valid, in minutes (default 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
